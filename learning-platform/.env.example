# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=lpuser
POSTGRES_PASSWORD=lppassword123
POSTGRES_DB=learningplatform

# ─────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────
MONGO_USER=lpmongouser
MONGO_PASSWORD=lpmongopwd123

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_PASSWORD=lpredisPwd123

# ─────────────────────────────────────────
# MinIO (Object Storage)
# ─────────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret123

# ─────────────────────────────────────────
# JWT & Security
# ─────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
SECRET_KEY=your-fastapi-secret-key-change-in-production

# ─────────────────────────────────────────
# Groq AI API (https://console.groq.com)
# ─────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─────────────────────────────────────────
# n8n Automation
# ─────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=n8n_admin_password

# ─────────────────────────────────────────
# SMTP (for n8n email notifications)
# Example: Gmail — use App Password if 2FA enabled
# ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SENDER=Learning Platform <noreply@yourplatform.com>

# ─────────────────────────────────────────
# Admin notification target (receives feedback digests)
# ─────────────────────────────────────────
ADMIN_EMAIL=admin@yourplatform.com
